# Copy to .env (per Hermes profile, as needed) and fill in. NEVER commit .env.
# These are consumed by Hermes/trading profiles, not by the generic engine directly.

# --- Gate channel: Telegram (orchestrator profile) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=          # your Telegram user id
TELEGRAM_HOME_CHANNEL=           # chat/channel id for outbound proposals + reports

# --- Web search for contextual research (researcher/scout profiles) ---
# Provide whichever backend your Hermes web toolset uses.
TAVILY_API_KEY=
# SERPER_API_KEY=
# BRAVE_API_KEY=

# --- Tradier production reads (options scout / portfolio snapshot / paper manager) ---
# Production brokerage credentials are used for real-time market/account READS only.
# TradierClient in V1 blocks money-moving POSTs by construction.
TRADIER_API_TOKEN=
TRADIER_ACCOUNT_ID=
# Optional Tradier sandbox token for separate delayed-data experiments.
TRADIER_SANDBOX_TOKEN=

# --- Deterministic options runtime ---
TRADING_STRATEGY_CONFIG=strategy/tasty_defined_risk_v1.yaml
MARKET_STATE_DB=./work/market_state.db
OPTIONS_LEDGER_DB=./work/options/options_ledger.db
PAPER_TRADING=true

# --- Sibling model-trader checkout (swing path/reference mechanisms) ---
# MODEL_TRADER_ROOT=../model-trader
# Do not set live-trading flags on these profiles.
# LIVE_TRADING=false

# --- Optional/future market-data enrichment ---
# Hyperliquid public candles need no key (model-trader HyperliquidAdapter).
# POLYGON_API_KEY=
# OPRA_API_KEY=
# ORATS_API_KEY=
# CBOE_LIVEVOL_API_KEY=
# UNUSUAL_WHALES_API_KEY=

# --- Optional: model-trader extract_strategy / agent veto (not the Hermes gate) ---
# ANTHROPIC_API_KEY=

# --- Engine overrides (optional; defaults derive from triage.yaml) ---
# TRIAGE_CONFIG=triage.yaml
# TRIAGE_VAULT_DIR=./work/vault/items
# HERMES_KANBAN_DB=               # normally injected by the dispatcher per task
